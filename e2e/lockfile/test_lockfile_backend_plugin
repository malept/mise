#!/usr/bin/env bash

export MISE_LOCKFILE=1
export MISE_EXPERIMENTAL=1

# Link the dummybackend plugin
mise plugins link dummybackend "$ROOT/crates/vfox/plugins/dummybackend"

# === Test 1: mise use auto-locks all platforms with URL and checksum ===
cat <<EOF >mise.toml
[tools]
"dummybackend:mytool" = "1.0.0"
EOF

touch mise.lock
mise use "dummybackend:mytool@1.0.0"

# Verify lockfile has entries for all 5 common platforms
assert_contains "cat mise.lock" "platforms.linux-x64"
assert_contains "cat mise.lock" "platforms.linux-arm64"
assert_contains "cat mise.lock" "platforms.macos-x64"
assert_contains "cat mise.lock" "platforms.macos-arm64"
assert_contains "cat mise.lock" "platforms.windows-x64"

# Verify URL format (vfox uses "linux"/"darwin" for os and "amd64"/"arm64" for arch)
assert_contains "cat mise.lock" "https://example.com/mytool/1.0.0/linux-amd64.tar.gz"
assert_contains "cat mise.lock" "https://example.com/mytool/1.0.0/linux-arm64.tar.gz"
assert_contains "cat mise.lock" "https://example.com/mytool/1.0.0/darwin-amd64.tar.gz"
assert_contains "cat mise.lock" "https://example.com/mytool/1.0.0/darwin-arm64.tar.gz"
assert_contains "cat mise.lock" "https://example.com/mytool/1.0.0/windows-amd64.tar.gz"

# Verify checksums are in sha256:value format
assert_contains "cat mise.lock" 'checksum = "sha256:dummychecksum_mytool_1.0.0_linux_amd64"'
assert_contains "cat mise.lock" 'checksum = "sha256:dummychecksum_mytool_1.0.0_darwin_arm64"'

# === Test 2: mise install reads lockfile and succeeds ===
rm -rf "$MISE_DATA_DIR/installs/dummybackend"
mise install
assert_contains "mise exec -- mytool" "1.0.0"

# === Test 3: bad checksum causes install failure ===
detect_platform
# Rewrite checksum for current platform to a bad value
sed -i "s/dummychecksum_mytool_1.0.0_${MISE_PLATFORM_OS/macos/darwin}_${MISE_PLATFORM_ARCH/x64/amd64}/badchecksum/" mise.lock
rm -rf "$MISE_DATA_DIR/installs/dummybackend"
assert_fail "mise install" "checksum"

# Cleanup
rm -f mise.toml mise.lock
